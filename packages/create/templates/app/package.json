{
  "name": "basis-ui-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "preinstall": "node -e \"if (Math.sign(26 - parseInt(process.versions.node)) === 1) { console.error('ERROR this app needs Node 26 or later, and the Node on the PATH is ' + process.version + ': run vp env on, so Vite+ runs the Node that .node-version pins rather than an older one on the PATH, then open a new terminal and run vp install again.'); process.exit(1) }\"",
    "prepare": "vp config",
    "dev": "vp dev",
    "build": "vp build",
    "test": "vp test"
  },
  "dependencies": {
    "@basis/parallax": "0.0.0",
    "@basis/ui": "0.0.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "msw": "3.0.4",
    "typescript": "7.0.2",
    "vite-plus": "1.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
