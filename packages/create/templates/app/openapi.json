      "post": {
        "summary": "Record Settlement",
        "description": "Record a settlement, with the interest accrued to its date, and book it with the ledger: the row and the booking\ncommit once the response validates, and the ledger is called after, by its id, as many times as it takes.",
        "operationId": "record_settlement",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettlementRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settlement"
                }
              }
