    "/bonds/{security}/coupons": {
      "get": {
        "summary": "Coupons",
        "description": "The bond's coupons, from its first to its last, which is paid at maturity, as a table: a frame of them.",
        "operationId": "coupons",
        "parameters": [
          {
            "name": "security",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9]{12}$",
              "description": "The bond's ISIN.",
              "title": "Security"
            },
            "description": "The bond's ISIN."
          }
        ],
        "responses": {
          "200": {
            "description": "The rows, as JSON, or as an Arrow IPC stream when the request's Accept asks for it",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CouponRow"
                  },
                  "title": "Response Coupons"
