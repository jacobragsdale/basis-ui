  "paths": {
    "/accrued-interest": {
      "get": {
        "summary": "Accrued Interest",
        "operationId": "accrued_interest",
        "parameters": [
          {
            "name": "face",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0,
              "title": "Face"
            }
          },
          {
            "name": "rate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1,
              "title": "Rate"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "End"
            }
          },
          {
            "name": "convention",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Convention"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accrual"
                }
              }
            }
          },
          "422": {
            "description": "invalid-request: The request is not valid; period-reversed: The period ends before it starts; period-too-long: The period is longer than this service accrues over",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/conventions": {
      "get": {
        "summary": "Conventions",
        "operationId": "conventions",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DayCount"
                  },
                  "type": "array",
                  "title": "Response Conventions"
                }
              }
            }
          },
          "422": {
            "description": "invalid-request: The request is not valid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
