        "show_as": {
          "$ref": "#/$defs/ShowAsName",
          "default": "value",
          "description": "How the value is shown."
        },
        "unit_column": {
          "default": null,
          "description": "A column naming each row's unit.",
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "default": null,
          "description": "The weight column, for `weighted_mean`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "aggregate"
      ],
      "type": "object"
    },
    "LayoutOhlc": {
      "additionalProperties": false,
      "description": "The price columns of a candlestick or OHLC chart, in a layout.",
      "properties": {
        "close": {
          "description": "The closing price.",
          "type": "string"
        },
        "high": {
          "description": "The highest price.",
          "type": "string"
        },
        "low": {
          "description": "The lowest price.",
          "type": "string"
        },
        "open": {
          "description": "The opening price.",
          "type": "string"
        }
      },
      "required": [
        "open",
        "high",
        "low",
        "close"
      ],
      "type": "object"
    },
    "LayoutOrder": {
      "description": "How a text column's values are ordered, in a layout.",
      "oneOf": [
        {
          "const": "text",
          "description": "Alphabetically, ignoring case, as text sorts without an order.",
          "type": "string"
        },
        {
          "const": "tenor",
          "description": "Tenors by length, `3M` before `1Y` and `10Y`: a whole number from 1 to\n9999 and `D`, `W`, `M` or `Y`. Text that is not a tenor comes after.",
          "type": "string"
        },
        {
          "const": "rating",
          "description": "Credit ratings, best first, on S&P's and Fitch's scale and Moody's, a\nnotch of one equal to the same notch of the other. Text that is not a\nrating, such as `NR`, comes after.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "As listed; values not listed come after.",
          "properties": {
            "values": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "By another column's smallest value among the rows with each value, such\nas a tenor bucket by its rows' shortest maturity.",
          "properties": {
            "by": {
              "type": "string"
            }
          },
          "required": [
            "by"
          ],
          "type": "object"
        }
      ]
    },
    "LayoutRange": {
      "additionalProperties": false,
      "description": "An x range a chart was zoomed to, in axis positions.",
      "properties": {
        "from": {
          "description": "The left edge.",
          "format": "double",
          "type": "number"
        },
        "to": {
          "description": "The right edge.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
