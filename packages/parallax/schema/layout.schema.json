        "to"
      ],
      "type": "object"
    },
    "LayoutSort": {
      "additionalProperties": false,
      "description": "A sort in a layout.",
      "properties": {
        "column": {
          "description": "The column.",
          "type": "string"
        },
        "descending": {
          "default": false,
          "description": "Largest first.",
          "type": "boolean"
        }
      },
      "required": [
        "column"
      ],
      "type": "object"
    },
    "LayoutTopN": {
      "additionalProperties": false,
