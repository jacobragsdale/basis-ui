        },
        {
          "const": "tenor",
          "description": "By tenor, labelled `3M` to `30Y`: the x column holds tenors as text,\nsuch as `3M` and `10Y`, or as years.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A view, as saved and sent.",
  "properties": {
    "chart": {
      "anyOf": [
        {
          "$ref": "#/$defs/LayoutChart"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Draws the view as a chart instead of a grid."
    },
    "column_widths": {
      "additionalProperties": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "default": {},
      "description": "Column widths in CSS pixels, chosen by the user. Keys are source column\nnames for flat views, `\"__measure:0\"`, `\"__measure:1\"` and so on for the\ndata columns of grouped views, and `\"__tree\"` for the group column. The\nengine ignores them.",
      "type": "object"
    },
    "columns": {
      "default": [],
      "description": "Columns of a flat view, in order. Empty means every column.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "dataset": {
      "default": "",
      "description": "The dataset the view reads. Empty in layouts sent with an open-view\nrequest, which names the dataset itself; when both are given they must\nagree.",
      "type": "string"
    },
    "detail": {
      "default": false,
      "description": "Groups `group_by` with the rows under them, in `sort` order and with the\n`columns`, as a grid does, rather than as a pivot of measures.",
      "type": "boolean"
    },
    "expand_depth": {
      "default": 0,
      "description": "Levels expanded by default.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "expanded": {
      "default": [],
      "description": "Groups expanded or collapsed by the user, by value.",
      "items": {
        "$ref": "#/$defs/LayoutExpanded"
      },
      "type": "array"
    },
    "filters": {
      "default": [],
      "description": "Row filters.",
      "items": {
        "$ref": "#/$defs/LayoutFilter"
      },
      "type": "array"
    },
    "formats": {
      "additionalProperties": {
        "$ref": "#/$defs/LayoutFormat"
      },
      "default": {},
      "description": "Display formats by source column. Measures take their column's format\nunless they set their own.",
      "type": "object"
    },
    "group_by": {
      "default": [],
      "description": "Row pivots, outermost first.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "group_sort": {
      "$ref": "#/$defs/LayoutGroupSort",
      "default": {
        "by": "key",
        "descending": false
      },
      "description": "Ordering of groups among their siblings."
    },
    "having": {
      "default": [],
      "description": "Aggregate filters.",
      "items": {
        "$ref": "#/$defs/LayoutHaving"
      },
      "type": "array"
    },
    "measures": {
      "default": [],
      "description": "Measures of a grouped view.",
      "items": {
        "$ref": "#/$defs/LayoutMeasure"
      },
      "type": "array"
    },
    "orders": {
      "additionalProperties": {
        "$ref": "#/$defs/LayoutOrder"
      },
      "description": "Orders of text columns other than alphabetical, by column: tenors by\nlength, ratings best first, a listed order, or another column's values.\nGroups at every level, column pivots, sorts, a chart's series and the\ncategories of bars, heatmaps and pies follow them; filters still compare\ntext.",
      "type": "object"
    },
    "parameters": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "The dataset's parameters, such as an as-of date.",
      "type": "object"
    },
    "pinned": {
      "default": [],
      "description": "Columns of a flat or detail view kept at the left while the rest scroll,\nin order. They come first, whatever `columns` says.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "search": {
      "default": "",
      "description": "Text to search for, ignoring case, in every searched column: the text\ncolumns a flat view shows, those and the group columns of a detail view,\nor the group and column-pivot columns of a pivot. Rows must match it as\nwell as the filters. Empty searches nothing.",
      "type": "string"
    },
    "sort": {
      "default": [],
      "description": "Sorts of a flat view.",
      "items": {
        "$ref": "#/$defs/LayoutSort"
      },
      "type": "array"
    },
    "split_by": {
      "default": [],
      "description": "Column pivots.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "titles": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Header text by source column; a column without one shows its name. The\nexport's headers are the same.",
      "type": "object"
    },
    "top_n": {
      "anyOf": [
        {
          "$ref": "#/$defs/LayoutTopN"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Top-N per set of siblings."
    },
    "totals": {
      "default": [],
      "description": "The totals row of a flat or detail view: at most one total per column,\neach a measure of its column. A detail view's group rows show them too.",
      "items": {
        "$ref": "#/$defs/LayoutMeasure"
      },
      "type": "array"
    },
    "version": {
      "default": 2,
      "description": "The layout version; [`LAYOUT_VERSION`] for documents this crate writes.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "Layout",
  "type": "object"
}
