        "measure": {
          "description": "The measure ranked, by index.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "n": {
          "description": "Groups to keep.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "other": {
          "default": true,
          "description": "Show the rest as one Other row.",
          "type": "boolean"
        }
      },
      "required": [
        "n",
        "measure"
      ],
      "type": "object"
    },
    "NegativeName": {
      "description": "How negative numbers are written, in a layout.",
      "oneOf": [
        {
          "const": "minus",
          "description": "`-1,234.50`",
          "type": "string"
        },
        {
          "const": "parentheses",
          "description": "`(1,234.50)`",
          "type": "string"
        }
      ]
    },
    "PrecisionName": {
      "description": "Sub-second digits in a layout.",
      "oneOf": [
        {
          "const": "seconds",
          "description": "Whole seconds.",
          "type": "string"
        },
        {
          "const": "milliseconds",
          "description": "Milliseconds.",
          "type": "string"
        },
        {
          "const": "microseconds",
          "description": "Microseconds.",
          "type": "string"
        }
      ]
    },
    "ShowAsName": {
      "description": "How a measure is shown.",
      "oneOf": [
        {
          "const": "value",
          "description": "The value.",
          "type": "string"
        },
        {
          "const": "percent_of_grand_total",
          "description": "Fraction of the grand total.",
          "type": "string"
        },
        {
          "const": "percent_of_column_total",
          "description": "Fraction of the column's total.",
          "type": "string"
        },
        {
          "const": "percent_of_row_total",
          "description": "Fraction of the row's total.",
          "type": "string"
        },
        {
          "const": "percent_of_parent",
          "description": "Fraction of the parent row's value.",
          "type": "string"
        }
      ]
    },
    "SuffixesName": {
      "description": "How an abbreviation is written, in a layout.",
      "oneOf": [
        {
          "const": "amount",
          "description": "`K`, `M` and `B`.",
          "type": "string"
        },
        {
          "const": "par",
          "description": "`M` for thousands, `MM` for millions and `BN` for billions, as bond\nmarkets write par amounts and `AmountInput` reads them back.",
          "type": "string"
        }
      ]
    },
    "TenorSpacingName": {
      "description": "How a tenor axis spaces tenors, in a layout.",
      "oneOf": [
        {
          "const": "even",
          "description": "The standard tenors 1M, 3M, 6M, 1Y, 2Y, 3Y, 5Y, 7Y, 10Y, 20Y, 30Y, 50Y\nand 100Y one step apart, and a tenor between two placed between them by\nlength, as desks' curve screens space them.",
          "type": "string"
        },
        {
          "const": "length",
          "description": "By length in years.",
