/target
*.arrow
node_modules/
/data
__pycache__/
/dist
# wasm-bindgen's output, which `vp run @basis/parallax#wasm` writes; only the glue's declaration is committed, so the
# package type-checks before the engine is built, and CI checks it still matches.
/wasm/*
!/wasm/parallax_wasm.d.ts
# The datasets the end-to-end specs load, which tests/e2e/charts/run.ts writes with parallax-datagen.
/tests/e2e/charts/data/
# The grid's harness's datasets, which tests/e2e/grid/data.sh writes with parallax-datagen.
/tests/e2e/grid/harness/public/data
# The pivot's harness's datasets, which tests/e2e/pivot/data.sh writes with parallax-datagen.
/tests/e2e/pivot/harness/public/data
