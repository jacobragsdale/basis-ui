{
  "name": "@basis/ui",
  "version": "0.0.0",
  "description": "The firm's React design system, app shell and Vite+ preset.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacobragsdale/basis-ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src/styles",
    "config"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset/index.d.mts",
      "default": "./dist/preset/index.mjs"
    },
    "./theme.css": "./src/styles/theme.css",
    "./tsconfig.json": "./config/tsconfig.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "theme": "node scripts/build-theme.ts"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@shadcn/lint": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "playwright": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/node": "catalog:",
    "@types/culori": "catalog:",
    "@types/node": "catalog:",
    "culori": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite-plus": "1.5.0"
  }
}
