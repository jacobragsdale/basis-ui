# This file is managed by basis-ui: `vp run sync` rewrites it from the installed @basis/ui, and `vp run verify` fails when it differs.
# The commit hook, a few seconds: vp staged formats and lint-fixes the staged files, then vp run verify runs its fast
# stages. The tests, the build and the budget run in the push hook. Never skip either with --no-verify: fix what each
# ERROR line says, and commit again.
vp staged && vp run verify --stage sync --stage config --stage lint --stage types --stage suppressions
