        "summary": "Overview",
        "description": "The desk's day: its figures, P&L by fund, exposure by sector and rating, and its alerts.",
        "operationId": "overview",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          },
          "422": {
            "description": "invalid-request: The request is not valid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "502": {
            "description": "service-failed: A call the request made failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "service-unavailable: A service or database the request calls is unavailable",
            "content": {
              "application/problem+json": {
