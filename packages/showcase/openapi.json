  "components": {
    "schemas": {
      "Alert": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "title": "Severity"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "raised_at": {
            "type": "string",
            "format": "date-time",
            "title": "Raised At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "severity",
          "title",
          "detail",
          "raised_at"
        ],
        "title": "Alert",
        "description": "Something on the book that wants a look today."
      },
      "Bond": {
        "properties": {
          "cusip": {
            "type": "string",
            "title": "CUSIP",
            "pattern": "^[0-9A-Z]{9}$"
          },
          "isin": {
            "type": "string",
            "title": "ISIN",
            "pattern": "^[A-Z0-9]{12}$"
          },
          "issuer": {
            "type": "string",
            "title": "Issuer"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "sector": {
            "type": "string",
            "title": "Sector"
          },
          "rating": {
            "type": "string",
            "title": "Rating"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "coupon_rate": {
            "type": "number",
            "title": "Coupon",
            "x-basis-format": {
              "kind": "pct",
              "decimals": 3
            }
          },
          "frequency": {
            "type": "integer",
            "enum": [
              1,
              2,
              4,
              12
            ],
            "title": "Frequency"
          },
          "day_count": {
            "type": "string",
            "enum": [
              "30/360",
              "ACT/360",
              "ACT/365",
              "ACT/ACT"
            ],
            "title": "Day Count"
          },
          "issued": {
            "type": "string",
            "format": "date",
            "title": "Issued"
          },
          "maturity": {
            "type": "string",
            "format": "date",
            "title": "Maturity"
          },
          "amount_outstanding": {
            "type": "number",
            "title": "Amount outstanding",
            "x-basis-format": {
              "kind": "money",
              "currency": "USD",
              "decimals": 0
            }
          },
          "price": {
            "type": "number",
            "title": "Price",
            "x-basis-format": {
              "kind": "price32",
              "step": "quarter"
            }
          },
          "yield": {
            "type": "number",
            "title": "Yield",
            "x-basis-format": {
              "kind": "pct",
              "decimals": 3
            }
          },
          "spread": {
            "type": "number",
            "title": "Spread",
            "x-basis-format": {
              "kind": "bps",
              "decimals": 1
            }
          },
          "duration": {
            "type": "number",
            "title": "Duration",
            "x-basis-format": {
              "kind": "number",
              "decimals": 2
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cusip",
          "isin",
          "issuer",
          "ticker",
          "sector",
          "rating",
          "currency",
          "coupon_rate",
          "frequency",
          "day_count",
          "issued",
          "maturity",
          "amount_outstanding",
          "price",
          "yield",
          "spread",
          "duration"
        ],
        "title": "Bond",
        "description": "A bond's terms and its price at the close."
      },
      "BookedTrade": {
        "properties": {
          "trade_id": {
            "type": "integer",
            "title": "Trade Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "trade_id",
          "status"
        ],
        "title": "BookedTrade",
        "description": "A trade the desk booked."
      },
      "CouponRow": {
        "properties": {
          "payment_date": {
            "type": "string",
            "format": "date",
            "title": "Payment Date"
          },
          "accrual_start": {
            "type": "string",
            "format": "date",
            "title": "Accrual Start"
          },
          "rate": {
            "type": "number",
