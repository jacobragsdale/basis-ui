# This file is managed by basis-ui: `vp run sync` rewrites it from the installed @basis/ui, and `vp run verify` fails when it differs.
# Serves the build: each file's .br or .gz beside it when the browser accepts one, the hashed assets cached for a year,
# and every other path checked with the server on each load, index.html answering each route the app owns. A missing
# asset is a 404, never index.html, and no error is cached, since in a rolling deploy an old server answers for a new
# asset until it is replaced.
:80 {
	root * /srv
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
