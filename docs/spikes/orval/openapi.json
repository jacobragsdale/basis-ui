{
  "openapi": "3.1.0",
  "info": {
    "title": "orval spike API",
    "version": "0.0.0"
  },
  "paths": {
    "/positions": {
      "get": {
        "summary": "Get Positions",
        "operationId": "get_positions",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "book",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Book"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "Symbol"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Position"
                  },
                  "title": "Response Get Positions"
                }
              }
            }
          },
          "default": {
            "description": "A problem details response (RFC 9457).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The request is not valid. `errors` names each field at fault.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Position",
        "operationId": "create_position",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PositionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Position"
                }
              }
            }
          },
          "default": {
            "description": "A problem details response (RFC 9457).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The request is not valid. `errors` names each field at fault.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/positions/{position_id}": {
      "get": {
        "summary": "Get Position",
        "operationId": "get_position",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "position_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Position Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Position"
                }
              }
            }
          },
          "default": {
            "description": "A problem details response (RFC 9457).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "A problem details response (RFC 9457).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The request is not valid. `errors` names each field at fault.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/exposures": {
      "get": {
        "summary": "Get Exposures",
        "operationId": "get_exposures",
        "responses": {
          "200": {
            "description": "The exposures, as JSON or, when the request accepts it, as an Arrow IPC stream.",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Exposure"
                  },
                  "type": "array",
                  "title": "Response Get Exposures"
                }
              },
              "application/vnd.apache.arrow.stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "A problem details response (RFC 9457).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Exposure": {
        "properties": {
          "book": {
            "type": "string",
            "title": "Book"
          },
          "sector": {
            "type": "string",
            "title": "Sector"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "exposure": {
            "type": "string",
            "title": "Exposure"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["book", "sector", "as_of", "exposure"],
        "title": "Exposure"
      },
      "ParameterError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "parameter": {
            "type": "string",
            "title": "Parameter",
            "description": "The name of the query or path parameter at fault."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["detail", "parameter"],
        "title": "ParameterError"
      },
      "PointerError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "pointer": {
            "type": "string",
            "title": "Pointer",
            "description": "A JSON Pointer (RFC 6901), in URI fragment form, to the field in the request body."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["detail", "pointer"],
        "title": "PointerError"
      },
      "Position": {
        "properties": {
          "position_id": {
            "type": "integer",
            "title": "Position Id"
          },
          "book": {
            "type": "string",
            "title": "Book"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "price": {
            "type": "string",
            "title": "Price"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["position_id", "book", "symbol", "quantity", "price", "as_of", "note"],
        "title": "Position"
      },
      "PositionCreate": {
        "properties": {
          "book": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "title": "Book"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9]{1,12}$",
            "title": "Symbol"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Price"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["book", "symbol", "quantity", "price", "as_of"],
        "title": "PositionCreate"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["title", "status"],
        "title": "Problem",
        "description": "An RFC 9457 problem details response."
      },
      "ValidationProblem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "errors": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/PointerError"
                },
                {
                  "$ref": "#/components/schemas/ParameterError"
                }
              ]
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["title", "status", "errors"],
        "title": "ValidationProblem",
        "description": "A problem details response for an invalid request, naming each field at fault as RFC 9457's example does."
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
